#include <iostream>
using namespace std;

int main() {
    int edad;
    cout << "Ingresa tu edad: ";
    cin >> edad;
    if (edad >= 18) {
        cout << "Eres mayor de edad,Ya puedes Trabajar en Coppel          " << endl;
    } else {
        cout << "Eres menor de edad,Aun no puedes Trabajar en Coppel" << endl;
    }
    return 0;
}
